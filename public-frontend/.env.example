# Environment Configuration
# Copy this file to .env.development or .env.production and fill in values

# API Base URL (Django backend)
NUXT_PUBLIC_API_URL=http://localhost:8080

# Admin App URL (existing Vue SPA)
NUXT_PUBLIC_APP_URL=http://localhost:5173

# This site's URL
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Environment (development, staging, production)
NUXT_PUBLIC_ENVIRONMENT=development

# Google Analytics ID (optional)
NUXT_PUBLIC_GA_ID=

# Social Links (optional)
NUXT_PUBLIC_TWITTER_URL=https://twitter.com/maddam_dam
NUXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/company/maddam
NUXT_PUBLIC_GITHUB_URL=https://github.com/maddam
